// The Strands Shell may run its builtins. The packs bind git and cargo, so each is decided only by
// its own Tool:: action, and the forbids below narrow these permits.
@id("shell_builtins")
permit (principal, action == Box::Action::"shell:exec", resource);

@id("all_git")
permit (principal, action in Tool::git::Action::"*", resource);

@id("all_cargo")
permit (principal, action in Tool::cargo::Action::"*", resource);

// The shell reads the demo tree, so it can enter the repository.
@id("demo_read")
permit (principal, action == Box::Action::"fs:read", resource)
when { context.input.path like "*packs-demo-temporal*" };

@id("dev_null")
permit (principal, action in [Box::Action::"fs:read", Box::Action::"fs:write"], resource)
when { context.input.path == "/dev/null" };

// A push needs a passing `cargo test` (or `cargo t`) in the last hour.
@id("push_after_tests")
@description("Run the tests first: git push needs a passing cargo test in the last hour.")
forbid (principal, action == Tool::git::Action::"push", resource)
unless temporal { formerly within 1h (Tool::cargo::Action::"test"::response{ output.status: 0 }) };

// One rule over every cargo action that raises an effect. Tool::cargo::Action::"*" is the group
// of all cargo actions, so the git actions, whose effects are Tool::git::Effect, stay out of it.
@id("lockfile_is_frozen")
@description("Cargo.lock may not change: pass --locked or --frozen.")
forbid (principal, action in Tool::cargo::Action::"*", resource)
when { context.input.effects.contains(Tool::cargo::Effect::"update_lockfile") };
