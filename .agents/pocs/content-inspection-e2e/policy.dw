// PROTOTYPE(content-inspection): allow httpbin, forbid a request whose body carries PII or a secret.
permit (principal, action == Box::Action::"net:resolve", resource)
when { context.input.host == "httpbin.org" && context.input.port == 443 };

permit (principal, action == Box::Action::"net:connect", resource)
when { context.input.host == "httpbin.org" && context.input.port == 443 };

permit (principal, action == Box::Action::"http:request", resource)
when { context.input.host == "httpbin.org" };

@id("no_pii_out")
forbid (principal, action == Box::Action::"http:request", resource)
when { Inspection::Content(["PII", "SECRET"]).labels.containsAny(["PII", "SECRET"]) };
